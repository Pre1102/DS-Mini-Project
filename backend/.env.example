# RabbitMQ AMQP endpoint. For a local installation, keep the default.
RABBITMQ_URL=amqp://guest:guest@localhost/

# SQLite files are created here, one database per service.
DATA_DIR=./data

# Optional gRPC overrides. Defaults use localhost and ports 50051-50054.
# ORDER_GRPC=127.0.0.1:50051
# PAYMENT_GRPC=127.0.0.1:50052
# INVENTORY_GRPC=127.0.0.1:50053
# NOTIFICATION_GRPC=127.0.0.1:50054
